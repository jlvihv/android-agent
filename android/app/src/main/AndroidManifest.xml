<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 前端走 loopback，仍然需要 INTERNET 权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 读 WiFi 开没开（`agent radios`）。和 NETWORK_STATE 一样是 normal，
         但漏了它 `isWifiEnabled()` 会直接抛 SecurityException —— 真机上撞到过。 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 沙箱里的 apk/curl 要联网 -->
    <!-- 沙箱的 /sdcard = 整个手机内部存储，/workspace = 其中的 Agent 文件夹。
         自用 App，直接要「所有文件访问权限」（Android 11+）；更老的系统用旧权限。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- 回合进行中的前台服务。为什么只要 SPECIAL_USE：它是一个「自用工具在
         跑活」的服务，不属于任何一个预设分类（媒体/定位/数据同步都不对）。
         以前是常驻，现在是回合开始起、结束停 —— 见 AgentForegroundService。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 通知权限。没有它 Android 13+ 不显示那个通知（服务照样跑，只是用户看不见）。
         只在真的起回合时问一次，不在启动时问。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 设备命令（`agent contacts|calendar|sms|location|alarm`）要的权限。
         都是**运行时**权限：第一次用到那个命令时才会弹框（见 AgentPermissions ——
         它把「弹窗 + 等人点」包成一次阻塞调用，因为命令跑在后台线程上）。
         列在这里只是“声明”，不等于已经拿到 —— 不声明的权限在系统设置里也开不了。 -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- 调音量（`agent volume`）。normal 权限，安装即得 —— 但**必须声明**，
         有些 ROM 不声明就直接把 setStreamVolume 当无效操作。 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 振动（`agent vibrate`）。同样是 normal 权限，但没声明的话
         `vibrate()` 会被系统默默丢掉（不报错，也不振）。 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 闹钟：交给系统时钟 App。SET_ALARM 是普通权限（安装即给），但**必须声明**，
         否则 AlarmClock 那几个 Intent 会被系统挡掉。 -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- 提升为 Live Updates（状态栏那颗常驻芯片）的权限。

         Android 17 新加的，保护级别是 `normal|appop` —— 安装时自动授予，但**必须声明**：
         没声明的话 `NotificationManager.canPostPromotedNotifications()` 一律回 false，
         于是我们永远只走普通通知那条路。实测：同一台机器（Pixel 10 / Android 17）上，
         OpenMinis 的 manifest 里有这行，它就有芯片；我们没有，就一直只能当通知栏一条。
         参考实现对得上：AOSP 16 的框架里还没有这个权限（那边只看 rich-ongoing 特性开关），
         17 才加上它。
         16 及更早的系统上这是未知权限，声明了无害（会被忽略）。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- Android 11+ 的包可见性：不声明这些，`queryIntentActivities` /
         `resolveActivity` 一律返回空，TextToSpeech 会以为"这台机器上没有语音引擎"。
         我们自己不查时钟 App（直接 startActivity + 捉 ActivityNotFoundException），
         但这两条声明几乎没代价，且能防住以后加“先判断能不能做”时的静默失败。 -->
    <queries>
        <intent>
            <action android:name="android.speech.tts.engine.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
    </queries>

    <application
        android:name=".AgentApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Agent">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AgentAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 回合进行中保活。`exported="false"`：只有我们自己能起它 -->
        <service
            android:name=".AgentForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="agent turn in progress (sandbox commands and web browsing on behalf of the user)" />
        </service>
    </application>
</manifest>
