<?xml version="1.0" encoding="utf-8"?>
<!--
  前端由 Rust 的 axum 从 http://127.0.0.1:<port> 提供（决策 D3）。

  Android 9 (API 28) 起默认禁止明文 HTTP，包括 loopback。不给例外的话
  WebView 加载会直接失败，报 ERR_CLEARTEXT_NOT_PERMITTED。
  实测确认过：这个例外是必需的，不是保险起见。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- includeSubdomains：沙箱里的网页在 sandbox.localhost 上（独立的源，
             见 core 的 http.rs），Chromium 把 *.localhost 直接解析到 loopback -->
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
