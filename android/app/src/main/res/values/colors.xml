<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 和 web 侧的设计令牌 ink 一致：**纯黑**（页面底色；OLED 省电）。
         这是 windowBackground —— 冷启动时 WebView 还没画出东西的那一层，
         不同步改就会先闪一下旧色再跳黑。 -->
    <color name="ink">#FF000000</color>

    <!-- 下面几个和 web/src/app.css 的设计令牌一一对应（原生面板用得到）。
         只补需要的三个：文字、次要文字、分隔线。 -->
    <color name="fg">#FFF9F9F7</color>
    <color name="muted">#FF97958D</color>
    <color name="hairline">#FF262624</color>
    <!-- 圆形按钮 / 药丸的底（web 的 color-control 令牌）：浏览器看板的标签用 -->
    <color name="control">#FF313131</color>

    <!-- 应用图标的底色：暖白（= fg），机器人是 ink（= 黑）。白底黑画。 -->
    <color name="ic_launcher_background">#FFF9F9F7</color>
</resources>
