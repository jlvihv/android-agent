<?xml version="1.0" encoding="utf-8"?>
<!--
  通知小图标：**干活中**（想 / 写正文时用），就是 App 那个机器人脑袋。

  小图标必须是「只有 alpha 的掩码」—— 系统按主题把它染成一个颜色（状态栏上通常
  是白色），所以这里只能有一个颜色，形状全靠填充面积。眼睛那种细节要做成**洞**
  （evenOdd 挖空），画成深色圆点的话染色之后整张脸就是一坨。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 天线：一颗圆点 + 一根杆 -->
    <path
        android:fillColor="#ffffff"
        android:pathData="M12,2.4 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0" />
    <path
        android:pathData="M12,4.2 L12,6.4"
        android:strokeColor="#ffffff"
        android:strokeLineCap="round"
        android:strokeWidth="1.6" />

    <!-- 头 + 两只眼睛（evenOdd：眼睛是洞）+ 嘴 -->
    <path
        android:fillColor="#ffffff"
        android:fillType="evenOdd"
        android:pathData="M6,7 L18,7 A2.6,2.6 0 0 1 20.6,9.6 L20.6,17.4 A2.6,2.6 0 0 1 18,20 L6,20 A2.6,2.6 0 0 1 3.4,17.4 L3.4,9.6 A2.6,2.6 0 0 1 6,7 Z M8.6,12.6 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0 Z M15.4,12.6 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0 Z" />
    <path
        android:pathData="M9.2,16.8 L14.8,16.8"
        android:strokeColor="#ffffff"
        android:strokeLineCap="round"
        android:strokeWidth="1.5" />
</vector>
